#. Plugin Name of the plugin
#: real-accessability.php
msgid "Real Accessibility: Accessibility Widget & Toolbar"
msgstr ""

#. Plugin URI of the plugin
#: real-accessability.php
msgid "https://wordpress.org/plugins/real-accessability/"
msgstr "https://wordpress.org/plugins/real-accessability/"

#. Description of the plugin
#: real-accessability.php
msgid ""
"An accessibility menu for your website - ready-made profiles, contrast "
"modes, text size and spacing, readable font, reading guide and more, styled "
"in your brand color."
msgstr ""
"Un meniu de accesibilitate pentru site-ul tău: profiluri predefinite, moduri "
"de contrast, dimensiunea și spațierea textului, font lizibil, ghid de citire "
"și multe altele, în culoarea brandului tău."

#. Author of the plugin
#: real-accessability.php
msgid "REALMEDIA"
msgstr "REALMEDIA"

#. Author URI of the plugin
