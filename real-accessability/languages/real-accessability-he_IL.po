msgid "Accessibility toolbar"
msgstr "תפריט נגישות"

msgid "Increase Font"
msgstr "הגדלת גופן"

msgid "Decrease Font"
msgstr "הקטנת גופן"

msgid "Black & White"
msgstr "תצוגת שחור לבן"

msgid "Inverse Colors"
msgstr "מצב ניגודיות גבוהה"

msgid "Highlight Links"
msgstr "הדגשת קישורים"

msgid "Regular Font"
msgstr "גופן קריא (אריאל)"

msgid "Reset"
msgstr "איפוס"

msgid "Page Reader"
msgstr "הקראת העמוד"

msgid "Read page content out loud"
msgstr "הקראת תוכן העמוד בקול"

msgid "Pause reading"
msgstr "השהיית ההקראה"

msgid "Stop reading"
msgstr "עצירת ההקראה"

msgid "Screen reader support (opens in a new tab)"
msgstr "עזרה בהקראת העמוד (נפתח בלשונית חדשה)"

#. Plugin Name of the plugin
msgid "Real Accessibility"
msgstr "Real Accessibility"

#. Description of the plugin
msgid "Adds an accessibility toolbar to your website - font resizer, color inverse, black & white view, link highlighting, readable font and a page reader."
msgstr "מוסיף לאתר תפריט נגישות - הגדלה והקטנה של גופן, ניגודיות גבוהה, תצוגת שחור לבן, הדגשת קישורים, גופן קריא והקראת העמוד."
