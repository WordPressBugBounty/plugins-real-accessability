#. Plugin Name of the plugin
#: real-accessability.php
msgid "Real Accessibility: Accessibility Widget & Toolbar"
msgstr ""

#. Plugin URI of the plugin
#: real-accessability.php
msgid "https://wordpress.org/plugins/real-accessability/"
msgstr "https://wordpress.org/plugins/real-accessability/"

#. Description of the plugin
#: real-accessability.php
msgid ""
"An accessibility menu for your website - ready-made profiles, contrast "
"modes, text size and spacing, readable font, reading guide and more, styled "
"in your brand color."
msgstr ""
"Menu dostępności dla twojej witryny: gotowe profile, tryby kontrastu, "
"rozmiar tekstu i odstępy, czytelna czcionka, linijka do czytania i wiele "
"więcej, w kolorze twojej marki."

#. Author of the plugin
#: real-accessability.php
msgid "REALMEDIA"
msgstr "REALMEDIA"

#. Author URI of the plugin
#: real-accessability.php
msgid "https://realmedia.co.il"
msgstr "https://realmedia.co.il"

