#. Plugin Name of the plugin
#: real-accessability.php
msgid "Real Accessibility: Accessibility Widget & Toolbar"
msgstr ""

#. Plugin URI of the plugin
#: real-accessability.php
msgid "https://wordpress.org/plugins/real-accessability/"
msgstr "https://wordpress.org/plugins/real-accessability/"

#. Description of the plugin
#: real-accessability.php
msgid ""
"An accessibility menu for your website - ready-made profiles, contrast "
"modes, text size and spacing, readable font, reading guide and more, styled "
"in your brand color."
msgstr ""
"Un menú de accesibilidad para tu sitio web: perfiles predefinidos, modos de "
"contraste, tamaño y espaciado del texto, fuente legible, guía de lectura y "
"más, con el color de tu marca."

#. Author of the plugin
#: real-accessability.php
msgid "REALMEDIA"
msgstr "REALMEDIA"

