#. Plugin URI of the plugin
#: real-accessability.php
msgid "https://wordpress.org/plugins/real-accessability/"
msgstr "https://wordpress.org/plugins/real-accessability/"

#. Description of the plugin
#: real-accessability.php
msgid ""
"An accessibility menu for your website - ready-made profiles, contrast "
"modes, text size and spacing, readable font, reading guide and more, styled "
"in your brand color."
msgstr ""
"Um menu de acessibilidade para o seu site: perfis predefinidos, modos de "
"contraste, tamanho e espaçamento do texto, letra legível, guia de leitura e "
"muito mais, com a cor da sua marca."

#. Author of the plugin
#: real-accessability.php
msgid "REALMEDIA"
msgstr "REALMEDIA"

#. Author URI of the plugin
#: real-accessability.php
msgid "https://realmedia.co.il"
msgstr "https://realmedia.co.il"

