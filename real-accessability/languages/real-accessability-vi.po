#. Plugin Name of the plugin
#: real-accessability.php
msgid "Real Accessibility: Accessibility Widget & Toolbar"
msgstr ""

#. Plugin URI of the plugin
#: real-accessability.php
msgid "https://wordpress.org/plugins/real-accessability/"
msgstr "https://wordpress.org/plugins/real-accessability/"

#. Description of the plugin
#: real-accessability.php
msgid ""
"An accessibility menu for your website - ready-made profiles, contrast "
"modes, text size and spacing, readable font, reading guide and more, styled "
"in your brand color."
msgstr ""
"Menu trợ năng cho trang web của bạn: hồ sơ có sẵn, chế độ tương phản, cỡ chữ "
"và khoảng cách, phông chữ dễ đọc, thước đọc và nhiều tính năng khác, theo "
"màu thương hiệu của bạn."

#. Author of the plugin
#: real-accessability.php
msgid "REALMEDIA"
msgstr "REALMEDIA"

